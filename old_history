export PERL_CACHE="${HOME}/perl5"
export NPG_LIB="${HOME}/perl5npg"
export PERLBREW_ROOT=${PERL_CACHE}
export WSI_NPG_GITHUB_URL="https://github.com/wtsi-npg"
export WSI_NPG_BUILD_BRANCH=devel
export PERL_VERSION=5.34.1
curl -sSL https://install.perlbrew.pl -o perlbrew.sh
sh perlbrew.sh
source ${PERL_CACHE}/etc/bashrc
perlbrew install --notest "perl-${PERL_VERSION}"
perlbrew use "${PERL_VERSION}"
perlbrew install-cpanm
echo "source ${PERL_CACHE}/etc/bashrc" >> "$HOME/.bash_profile"
cpanm --local-lib=${PERL_CACHE} local::lib
eval $(perl -I "${PERL_CACHE}/lib/perl5/" -Mlocal::lib="${NPG_LIB}")
eval $(perl -I "${PERL_CACHE}/lib/perl5/" -Mlocal::lib)
cpanm --quiet --notest Module::Build
./scripts/install_wsi_dependencies.sh "${NPG_LIB}" perl-dnap-utilities ml_warehouse
cpanm --installdeps --notest .
export TEST_AUTHOR=1
perl Build.PL
./Build test --verbose

